---
import SectionHead from "./SectionHead.astro";
import FeatureBlock from "./FeatureBlock.astro";
import { count, meta } from "../lib/data";
import { groupFeatures } from "../lib/featuregroups";

// Features the font build lists with a sample, grouped; layout-engine features without one are left out.
const groups = groupFeatures(meta.features);
const total = groups.reduce((n, g) => n + g.items.reduce((m, i) => m + 1 + i.folded.length, 0), 0);
---

<section id="features" class="sec" aria-labelledby="features-h">
  <SectionHead
    id="features-h"
    title="Features"
    lead={total
      ? `${count(total, "OpenType feature")}, each example set without the feature and with it.`
      : "No OpenType features in this build yet."}
  />
  {
    groups.map((g) => (
      <div class="group grid" data-group={g.id}>
        <h3 class="side gname">{g.title}</h3>
        <div class:list={["main", g.id === "always" ? "list" : "blocks"]}>
          {g.items.map((item) =>
            g.id === "always" ? (
              <FeatureBlock item={item} size={item.tag === "kern" ? "large" : "compact"} />
            ) : (
              <FeatureBlock item={item} />
            ),
          )}
        </div>
      </div>
    ))
  }
</section>

<style>
  .sec {
    padding-top: var(--s7);
  }
  .group + .group {
    margin-top: var(--s6);
  }
  .gname {
    font-size: var(--f-body);
    font-weight: 600;
    line-height: 1.3;
    padding-top: var(--s2);
  }
  .blocks {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: var(--s5) var(--gap);
  }
  .list {
    display: grid;
    gap: var(--s4);
  }
  @media (max-width: 760px) {
    .gname {
      padding-top: 0;
      margin-bottom: var(--s2);
    }
    .group + .group {
      margin-top: var(--s5);
    }
  }
</style>
