---
import SectionHead from "./SectionHead.astro";
import { count, meta } from "../lib/data";

// Features the font build lists with a sample; layout-engine features without one are left out.
const shown = meta.features.filter((f) => f.sample && f.sample.trim());
// Features a browser applies by itself start switched on.
const byDefault = new Set(["kern", "mark", "mkmk", "ccmp", "locl", "liga", "calt", "clig", "rlig"]);
---

<section id="features" class="sec" aria-labelledby="features-h">
  <SectionHead
    id="features-h"
    title="Features"
    lead={shown.length
      ? `${count(shown.length, "OpenType feature")}, each beside an example.`
      : "No OpenType features in this build yet."}
  />
  <ul class="list">
    {
      shown.map((f) => {
        const on = byDefault.has(f.tag);
        return (
          <li class="feat grid" data-feature={f.tag}>
            <div class="side">
              <p class="label tag">{f.tag}</p>
              <p class="fname">{f.name}</p>
            </div>
            <div class="main row">
              <p class="sample spec" style={`font-feature-settings: "${f.tag}" ${on ? 1 : 0}`}>{f.sample}</p>
              <label class="switch">
                <input type="checkbox" role="switch" checked={on} data-tag={f.tag} />
                <span class="visually-hidden">{f.name}</span>
                <span class="track" aria-hidden="true"></span>
              </label>
            </div>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .sec {
    padding-top: var(--s7);
  }
  .feat {
    position: relative;
    padding-block: var(--s3);
    align-items: center;
  }
  .feat::before {
    content: "";
    position: absolute;
    top: 0;
    left: var(--m);
    right: var(--m);
    border-top: 1px solid var(--rule);
  }
  .tag {
    color: var(--mark);
  }
  .fname {
    font-size: var(--f-small);
  }
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
  }
  .sample {
    font-size: clamp(1.75rem, 4.2vw, 3.5rem);
    line-height: 1.15;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .switch {
    position: relative;
    flex: none;
    width: 3rem;
    height: 1.75rem;
    cursor: pointer;
  }
  .switch input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .track {
    position: absolute;
    inset: 0;
    border-radius: 1rem;
    background: var(--track);
    transition: background-color 200ms ease;
    pointer-events: none;
  }
  .track::after {
    content: "";
    position: absolute;
    top: 0.15rem;
    left: 0.15rem;
    width: 1.45rem;
    height: 1.45rem;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.25);
    transition: transform 220ms var(--ease-out);
  }
  .switch input:checked + span + .track {
    background: var(--ink);
  }
  .switch input:checked + span + .track::after {
    transform: translateX(1.25rem);
  }
  .switch input:focus-visible + span + .track {
    outline: 2px solid var(--mark);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .track,
    .track::after {
      transition: none;
    }
  }
  @media (max-width: 760px) {
    .feat {
      row-gap: var(--s2);
    }
    .side {
      display: flex;
      gap: var(--s2);
      align-items: baseline;
    }
  }
</style>
