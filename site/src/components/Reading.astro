---
import SectionHead from "./SectionHead.astro";
import { count, meta } from "../lib/data";
import { order, texts, tiers } from "../lib/texts";

const listed = new Map(meta.languages.map((l) => [l.tag, l.name]));
const tags = order.filter((t) => texts[t] && (!listed.size || listed.has(t)));
const items = tags.map((tag, i) => ({
  tag,
  name: listed.get(tag) ?? tag,
  text: texts[tag],
  px: tiers[Math.min(i, tiers.length - 1)],
}));
const rows = [20, 16, 13, 11].map((px) => items.filter((it) => it.px === px)).filter((r) => r.length);
// Every language the font build lists, each with its own sample line, in alphabetical order.
const samples = meta.languages
  .filter((l) => typeof l.sample === "string" && l.sample)
  .map((l) => ({ tag: l.tag, name: l.name, sample: l.sample as string }))
  .sort((a, b) => a.name.localeCompare(b.name, "en"));
---

<section id="reading" class="sec" aria-labelledby="reading-h">
  <SectionHead
    id="reading-h"
    title="Reading"
    lead={meta.languages.length
      ? `Text sizes, in ${items.length} of the ${count(meta.languages.length, "language")} the font covers.`
      : `Text sizes, in ${count(items.length, "language")}.`}
  />
  <div class="grid">
    <div class="main tiers">
      {
        rows.map((row) => (
          <div class="tier" style={`--cols: ${row.length}`}>
            {row.map((it) => (
              <article class="para">
                <p class="label">
                  {it.name} <span class="num">{it.px} px</span>
                </p>
                <p lang={it.tag} class={`spec t${it.px}`}>{it.text}</p>
              </article>
            ))}
          </div>
        ))
      }
    </div>
  </div>
  {
    samples.length > 0 && (
      <div class="grid every">
        <h3 class="side label">{count(samples.length, "language")}</h3>
        <ul class="main langs">
          {samples.map((l) => (
            <li>
              <span class="label">{l.name}</span>
              <span lang={l.tag} class="spec line">
                {l.sample}
              </span>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>

<style>
  .sec {
    padding-top: var(--s7);
  }
  .tiers {
    display: grid;
    gap: var(--s5);
  }
  .tier {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--s5) var(--gap);
    align-items: start;
  }
  .para {
    display: grid;
    gap: var(--s2);
    padding-top: var(--s2);
    border-top: 1px solid var(--rule);
  }
  .para .label .num {
    color: var(--ink);
    margin-left: 0.4em;
  }
  .para p:last-child {
    max-width: 32em;
    hyphens: auto;
    text-wrap: pretty;
  }
  .t20 {
    font-size: 1.25rem;
    line-height: 1.5;
  }
  .t16 {
    font-size: 1rem;
    line-height: 1.55;
  }
  .t13 {
    font-size: 0.8125rem;
    line-height: 1.6;
  }
  .t11 {
    font-size: 0.6875rem;
    line-height: 1.65;
  }
  .every {
    margin-top: var(--s6);
    row-gap: var(--s2);
  }
  .every h3 {
    padding-top: var(--s2);
  }
  .langs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr));
    column-gap: var(--gap);
  }
  .langs li {
    display: grid;
    align-content: start;
    gap: 0.1rem;
    padding-block: var(--s2);
    border-top: 1px solid var(--rule);
  }
  .langs .line {
    font-size: 1.0625rem;
    line-height: 1.45;
    text-wrap: pretty;
  }
  @media (max-width: 900px) {
    .tier {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
