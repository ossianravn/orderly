---
import "../styles/tokens.css";
import "../styles/base.css";
import { base, files, meta } from "../lib/data";

const title = `${meta.family}, a geometric grotesk`;
const description =
  "Orderly is an open-source geometric grotesk variable font with a weight axis and an optical-size axis, drawn in code.";
const fontFace = `
@font-face {
  font-family: "Orderly";
  src: url("${files.woff2.href}") format("woff2");
  font-weight: 100 900;
  font-style: normal;
  font-display: swap;
}
@font-face {
  font-family: "Orderly Fallback";
  src: local("Arial"), local("Helvetica Neue"), local("Helvetica");
  size-adjust: 104%;
  ascent-override: 100%;
  descent-override: 30%;
  line-gap-override: 0%;
}`;
---

<!doctype html>
<html lang="en" data-opsz="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f5f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111315" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={files.woff2.href} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontFace} />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add("js");
        try {
          var t = localStorage.getItem("orderly-theme");
          if (t === "light" || t === "dark") d.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to the specimen</a>
    <slot />
    <script>
      import "../scripts/main";
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--m);
    top: -4rem;
    padding: var(--s2) var(--s3);
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius);
    z-index: 30;
  }
  .skip:focus {
    top: var(--s2);
  }
</style>
